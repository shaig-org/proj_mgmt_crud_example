{
  "name": "project-management-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --config vite.config.e2e.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --reporter=list",
    "e2e:scenarios": "playwright test --project=scenarios --reporter=list",
    "e2e:headed": "playwright test --headed --reporter=list",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "walkthroughs:generate": "tsx scripts/generate-walkthroughs.ts",
    "walkthroughs:serve": "npx --yes serve walkthroughs/gallery -l 4173",
    "postinstall": "node -e \"const { spawnSync } = require('node:child_process'); ['../devtools/install-git-hooks.sh', '../devtools/setup-worktree-ports.sh'].forEach(s => spawnSync('bash', [s], { stdio: 'inherit' }))\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright": "^1.56.1",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "jsdom": "^25.0.0"
  }
}
