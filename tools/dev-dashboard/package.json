{
  "name": "dev-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predashboard": "node scripts/check-staleness.mjs",
    "dashboard": "vite --host 127.0.0.1 --port 5179",
    "dashboard:check": "node scripts/check-staleness.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5179",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "smoke": "playwright test"
  },
  "dependencies": {
    "mermaid": "^11.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "jsdom": "^25.0.0"
  }
}
